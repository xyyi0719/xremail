# ---- Rust ----
/target
**/target/

# `cargo sqlx prepare` 用的临时数据库（见 docs/DEVELOPMENT 或 CI 脚本）。
# 它只是迁移应用后的空库，用于编译期校验 SQL，随时可重建。
/.sqlx-prep/
*.rs.bk
*.pdb
*.rlib

# ---- Node / Vite ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
.npm

# ---- Tauri ----
# Android/iOS 生成物（含签名文件与私钥，切勿提交）
apps/shell/src-tauri/gen/
apps/shell/src-tauri/gen/android/
apps/shell/gen/
apps/shell/gen/schemas/
*.keystore
*.jks
*.p12
*.mobileprovision

# ---- 密钥与本地配置（严禁提交）----
.env
.env.*
!.env.example
oauth/clients.json
oauth/clients.local.json
**/clients.local.json

# ---- 本地数据 / 运行时产物 ----
data/
*.db
*.db-wal
*.db-shm
/logs/
/tmp/

# ---- 编辑器 ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# 本地构建缓存（沙箱下 $HOME 只读，缓存改放工作区）
.devcache/

# Python 字节码
__pycache__/
